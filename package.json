{
  "name": "agora-club-website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply agora-club-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply agora-club-db --remote",
    "db:seed:local": "node scripts/seed-admins.mjs --local",
    "db:seed:remote": "node scripts/seed-admins.mjs --remote",
    "deploy": "npm run build && wrangler deploy",
    "dev": "concurrently -k -n CLIENT,WORKER -c blue,green \"npm run dev:client\" \"npm run dev:worker\"",
    "dev:client": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "preview": "npm run build && wrangler dev --port 8787",
    "start": "npm run dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.5.2",
    "vite": "^7.3.3",
    "vitest": "~3.2.0",
    "wrangler": "^4.90.1"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0"
  }
}
